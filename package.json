{
  "name": "giskard-docs",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/convert-notebooks.mjs && astro dev",
    "start": "astro dev",
    "build": "pnpm run format && node scripts/convert-notebooks.mjs && astro build && node scripts/generate-redirects.mjs",
    "build:ci": "node scripts/convert-notebooks.mjs && astro build && node scripts/generate-redirects.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write 'src/**/*.{md,mdx}' && node scripts/format-code-blocks.mjs",
    "format:prose": "prettier --write 'src/**/*.{md,mdx}'",
    "format:code": "node scripts/format-code-blocks.mjs",
    "test:tables": "node scripts/check-mdx-tables.mjs",
    "test:redirects": "node scripts/check-redirects.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "report:seo": "node scripts/report-seo.mjs",
    "test:python-snippets": "node scripts/check-python-snippets.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.42.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.7",
    "astro-mermaid": "2.1.0",
    "mermaid": "12.1.0",
    "sharp": "0.35.5",
    "starlight-auto-sidebar": "0.4.1",
    "starlight-image-zoom": "0.16.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "pyright": "1.1.414",
    "prettier": "3.9.9",
    "wrangler": "4.148.0"
  }
}
