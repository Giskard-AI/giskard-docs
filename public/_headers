# Content-hashed build assets (CSS, JS, fonts, source images the /_image
# endpoint reads from). The hash changes when the file changes, so a
# far-future immutable cache is safe. Transformed images served from
# /_image already carry their own immutable cache-control.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
