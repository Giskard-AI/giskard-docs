---
type Support = "core" | "partial" | "none";

interface Tool {
  id: string;
  name: string;
  href: string;
  featured?: boolean;
}
interface Cell {
  support: Support;
  summary: string;
  href?: string;
}

interface Row {
  criterion: string;
  cells: Record<string, Cell>;
}

const tools: Tool[] = [
  { id: "giskard", name: "Giskard OSS", href: "/oss", featured: true },
  { id: "garak", name: "garak", href: "https://docs.garak.ai/" },
  {
    id: "promptfoo",
    name: "promptfoo",
    href: "https://www.promptfoo.dev/docs/",
  },
  { id: "pyrit", name: "PyRIT", href: "https://azure.github.io/PyRIT/" },
  {
    id: "deepeval",
    name: "DeepEval + DeepTeam",
    href: "https://deepeval.com/docs/getting-started",
  },
];

const rows: Row[] = [
  {
    criterion: "Dynamic scan",
    cells: {
      giskard: {
        support: "core",
        summary: "Target-aware generators",
        href: "/oss/scan/explanation/how-scan-works",
      },
      garak: {
        support: "partial",
        summary: "Probe catalog + auto red-team",
        href: "https://docs.garak.ai/garak/garak-components/vulnerability-probes",
      },
      promptfoo: {
        support: "core",
        summary: "Plugins and strategies",
        href: "https://www.promptfoo.dev/docs/red-team/quickstart/",
      },
      pyrit: {
        support: "partial",
        summary: "Programmable attacks",
        href: "https://azure.github.io/PyRIT/",
      },
      deepeval: {
        support: "core",
        summary: "DeepTeam attack generation",
        href: "https://deepeval.com/docs/red-teaming-introduction",
      },
    },
  },
  {
    criterion: "Structured agents",
    cells: {
      giskard: {
        support: "core",
        summary: "Pydantic input schemas",
        href: "/oss/scan/how-to/wrap-your-agent",
      },
      garak: {
        support: "partial",
        summary: "Generative-model and app interfaces",
        href: "https://docs.garak.ai/garak/garak-components/using-generators",
      },
      promptfoo: {
        support: "partial",
        summary: "HTTP and custom providers",
        href: "https://www.promptfoo.dev/docs/providers/",
      },
      pyrit: {
        support: "partial",
        summary: "Prompt targets",
        href: "https://azure.github.io/PyRIT/",
      },
      deepeval: {
        support: "partial",
        summary: "Callbacks and test cases",
        href: "https://deepeval.com/docs/red-teaming-introduction#model-callback",
      },
    },
  },
  {
    criterion: "Multi-agent and multi-turn",
    cells: {
      giskard: {
        support: "partial",
        summary: "Stateful tests; user-wrapped systems",
        href: "/oss/scan/how-to/wrap-your-agent",
      },
      garak: {
        support: "partial",
        summary: "Some multi-turn probes",
        href: "https://docs.garak.ai/garak/automatic-red-teaming/garaks-auto-red-team",
      },
      promptfoo: {
        support: "partial",
        summary: "Multi-turn strategies",
        href: "https://www.promptfoo.dev/docs/red-team/strategies/",
      },
      pyrit: {
        support: "partial",
        summary: "Multi-turn attacks",
        href: "https://azure.github.io/PyRIT/",
      },
      deepeval: {
        support: "partial",
        summary: "Metrics + DeepTeam attacks",
        href: "https://deepeval.com/docs/metrics-conversation-completeness",
      },
    },
  },
  {
    criterion: "Quality evaluation",
    cells: {
      giskard: {
        support: "core",
        summary: "Checks + quality_scan",
        href: "/oss/checks/explanation/when-to-use-which-check",
      },
      garak: {
        support: "partial",
        summary: "Security focus; some quality probes",
        href: "https://docs.garak.ai/garak",
      },
      promptfoo: {
        support: "core",
        summary: "Assertions and metrics",
        href: "https://www.promptfoo.dev/docs/configuration/expected-outputs/",
      },
      pyrit: {
        support: "partial",
        summary: "Attack scorers",
        href: "https://azure.github.io/PyRIT/",
      },
      deepeval: {
        support: "core",
        summary: "Evaluation metrics",
        href: "https://deepeval.com/docs/metrics-introduction",
      },
    },
  },
  {
    criterion: "Red teaming",
    cells: {
      giskard: {
        support: "core",
        summary: "Some target-aware generators",
        href: "/oss/solutions/scan-vulnerabilities",
      },
      garak: {
        support: "core",
        summary: "Named vulnerability probes",
        href: "https://docs.garak.ai/garak",
      },
      promptfoo: {
        support: "core",
        summary: "Plugins and strategies",
        href: "https://www.promptfoo.dev/docs/red-team/",
      },
      pyrit: {
        support: "core",
        summary: "Attacks and executors",
        href: "https://azure.github.io/PyRIT/",
      },
      deepeval: {
        support: "core",
        summary: "DeepTeam red teaming",
        href: "https://deepeval.com/docs/red-teaming-introduction",
      },
    },
  },
  {
    criterion: "pytest",
    cells: {
      giskard: {
        support: "partial",
        summary: "User-managed pytest-asyncio",
        href: "/oss/checks/how-to/run-in-pytest",
      },
      garak: {
        support: "none",
        summary: "CLI/harness; no native pytest",
      },
      promptfoo: {
        support: "partial",
        summary: "CI; pytest is user-managed",
      },
      pyrit: {
        support: "none",
        summary: "Executor APIs; no native pytest",
      },
      deepeval: {
        support: "core",
        summary: "deepeval test run",
        href: "https://deepeval.com/docs/evaluation-test-cases",
      },
    },
  },
];

for (const row of rows) {
  for (const tool of tools) {
    if (!(tool.id in row.cells)) {
      throw new Error(
        `ToolComparison: missing ${tool.id} cell for "${row.criterion}"`,
      );
    }
  }
}

function supportLabel(support: Support): string {
  switch (support) {
    case "core":
      return "Core";
    case "partial":
      return "Partial";
    case "none":
      return "None";
    default: {
      const _exhaustive: never = support;
      return _exhaustive;
    }
  }
}

function isExternal(href: string): boolean {
  return href.startsWith("http://") || href.startsWith("https://");
}
---

<div class="not-content tool-comparison">
  <ul class="tool-comparison-legend" aria-label="Comparison legend">
    <li>
      <span class="tool-comparison-pill" data-support="core">Core</span>
      First-class workflow
    </li>
    <li>
      <span class="tool-comparison-pill" data-support="partial">Partial</span>
      Narrower or user-managed workflow
    </li>
    <li>
      <span class="tool-comparison-pill" data-support="none">None</span>
      Not a documented primary workflow
    </li>
  </ul>

  <div
    class="tool-comparison-scroll"
    role="region"
    aria-labelledby="tool-comparison-caption"
    tabindex="0"
  >
    <table class="tool-comparison-table">
      <caption id="tool-comparison-caption" class="sr-only">
        Capability comparison of Giskard OSS, garak, promptfoo, PyRIT, and
        DeepEval plus DeepTeam
      </caption>
      <thead>
        <tr>
          <th scope="col">Capability</th>
          {
            tools.map((tool) => (
              <th
                scope="col"
                class:list={{ "is-featured": tool.featured }}
              >
                <a
                  href={tool.href}
                  {...(isExternal(tool.href)
                    ? { rel: "noreferrer" }
                    : {})}
                >
                  {tool.name}
                </a>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.criterion}</th>
              {tools.map((tool) => {
                const cell = row.cells[tool.id];
                if (!cell) {
                  throw new Error(
                    `ToolComparison: missing ${tool.id} cell for "${row.criterion}"`,
                  );
                }
                const summary = cell.href ? (
                  <a
                    href={cell.href}
                    {...(isExternal(cell.href)
                      ? { rel: "noreferrer" }
                      : {})}
                  >
                    {cell.summary}
                  </a>
                ) : (
                  cell.summary
                );
                return (
                  <td class:list={{ "is-featured": tool.featured }}>
                    <span
                      class="tool-comparison-pill"
                      data-support={cell.support}
                    >
                      {supportLabel(cell.support)}
                    </span>
                    <span class="tool-comparison-summary">{summary}</span>
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .tool-comparison {
    margin-block: 1.25rem 1.5rem;
  }

  .tool-comparison-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0 0 0.85rem;
    padding: 0;
    list-style: none;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--sl-color-gray-2, #64748b);
  }

  .tool-comparison-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tool-comparison-scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
  }

  .tool-comparison-scroll:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .tool-comparison-table {
    display: table;
    table-layout: fixed;
    width: 100%;
    min-width: 40rem;
    margin: 0;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .tool-comparison-table :is(th, td) {
    padding: 0.65rem 0.55rem;
    text-align: left;
    vertical-align: top;
    overflow-wrap: break-word;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg);
  }

  .tool-comparison-table tbody tr:last-child :is(th, td) {
    border-bottom: none;
  }

  .tool-comparison-table thead th {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    vertical-align: bottom;
    background: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .tool-comparison-table thead a {
    color: inherit;
    text-decoration: none !important;
  }

  .tool-comparison-table thead a:hover {
    text-decoration: underline !important;
    text-underline-offset: 0.18em;
  }

  .tool-comparison-table td a {
    text-decoration-color: color-mix(in srgb, currentColor 38%, transparent);
    text-underline-offset: 0.18em;
  }

  .tool-comparison-table tbody th {
    font-weight: 700;
  }

  .tool-comparison-table :is(th, td):first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 9.25rem;
    width: 9.25rem;
    padding-inline: 0.8rem;
    box-shadow: 1px 0 0 var(--sl-color-hairline);
  }

  .tool-comparison-table thead th:first-child {
    z-index: 2;
  }

  .tool-comparison-table :is(th, td).is-featured {
    background: color-mix(in srgb, #0284c9 10%, var(--sl-color-bg));
    box-shadow: inset 3px 0 0 #0284c9;
  }

  .tool-comparison-table thead th.is-featured {
    background: color-mix(in srgb, #0284c9 14%, var(--sl-color-bg-nav));
  }

  :global(:root[data-theme="dark"]) .tool-comparison-table :is(th, td).is-featured {
    background: color-mix(
      in srgb,
      var(--sl-color-accent) 14%,
      var(--sl-color-bg)
    );
    box-shadow: inset 3px 0 0 var(--sl-color-accent);
  }

  :global(:root[data-theme="dark"]) .tool-comparison-table thead th.is-featured {
    background: color-mix(
      in srgb,
      var(--sl-color-accent) 16%,
      var(--sl-color-bg-nav)
    );
  }

  .tool-comparison-table tbody tr:hover :is(th, td) {
    background: color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg));
  }

  .tool-comparison-table tbody tr:hover :is(th, td).is-featured {
    background: color-mix(in srgb, #0284c9 16%, var(--sl-color-bg));
  }

  :global(:root[data-theme="dark"])
    .tool-comparison-table
    tbody
    tr:hover
    :is(th, td).is-featured {
    background: color-mix(
      in srgb,
      var(--sl-color-accent) 20%,
      var(--sl-color-bg)
    );
  }

  .tool-comparison-table td {
    min-width: 0;
  }

  .tool-comparison-pill {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin: 0;
    padding: 0.12rem 0.42rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .tool-comparison-pill[data-support="core"] {
    color: #14532d;
    background: #dcfce7;
  }

  .tool-comparison-pill[data-support="partial"] {
    color: #92400e;
    background: #fef3c7;
  }

  .tool-comparison-pill[data-support="none"] {
    color: #475569;
    background: #e2e8f0;
  }

  :global(:root[data-theme="dark"]) .tool-comparison-pill[data-support="core"] {
    color: #022c22;
    background: #05d939;
  }

  :global(:root[data-theme="dark"])
    .tool-comparison-pill[data-support="partial"] {
    color: #ffedd5;
    background: rgba(249, 115, 22, 0.35);
  }

  :global(:root[data-theme="dark"]) .tool-comparison-pill[data-support="none"] {
    color: #c6ffff;
    background: rgba(198, 255, 255, 0.12);
  }

  .tool-comparison-summary {
    display: block;
    margin-top: 0.45rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
